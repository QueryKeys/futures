# ───────────────────────────────────────────────────────────────────────────
# Polymarket-IL — environment variables
# Copy to `.env.local` (web) and configure Worker secrets via `wrangler secret`.
# ───────────────────────────────────────────────────────────────────────────

# ── Web (Next.js) ──────────────────────────────────────────────────────────
# Public base URL of the deployed Worker. Used by the browser.
NEXT_PUBLIC_WORKER_BASE_URL=https://polymarket-il-api.example.workers.dev

# Optional: Firebase web config (filled when Firestore + Auth are wired in)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ── Worker (Cloudflare) ────────────────────────────────────────────────────
# These must be set as Wrangler *secrets*, never committed:
#   wrangler secret put ANTHROPIC_API_KEY
#   wrangler secret put VAPID_PRIVATE_KEY
#
# ANTHROPIC_API_KEY=sk-ant-...
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# ALLOWED_ORIGINS=https://your-domain.com,http://localhost:3000
