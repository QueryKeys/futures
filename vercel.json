{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "npm -w @poly-il/web run build",
  "outputDirectory": "web/.next",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- web shared package.json vercel.json"
}
